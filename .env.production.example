# Copy to .env.production and fill in before: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Database ---
DATABASE_USER=mart_admin
DATABASE_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_NAME=mart_omnichannel

# --- API secrets ---
JWT_SECRET=CHANGE_ME_long_random_string
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://admin.yourdomain.com,https://shop.yourdomain.com

# First boot: create tables automatically. Set to false after first successful deploy.
TYPEORM_SYNCHRONIZE=true
# Optional demo seed on API container start (requires ts-node in image — keep false in real prod)
RUN_SEED_ON_START=false

# --- Public URLs (baked into web builds) ---
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
PUBLIC_FACILITY_ID=00000000-0000-0000-0000-000000000002
PUBLIC_AUTH_TOKEN=
PUBLIC_TAX_RATE=18

# --- Host publish ports (behind nginx/caddy reverse proxy in real prod) ---
API_PUBLISH_PORT=3000
ADMIN_PUBLISH_PORT=8081
STORE_PUBLISH_PORT=8082
