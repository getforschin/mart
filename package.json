{
  "name": "mart-omnichannel",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Offline-First Omnichannel Retail Ecosystem",
  "scripts": {
    "infra:up": "bash scripts/docker-up.sh",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "setup": "bash scripts/setup.sh",
    "backend:install": "npm install --prefix central-backend",
    "backend:build": "npm run build --prefix central-backend",
    "backend:seed": "npm run seed --prefix central-backend",
    "backend:start": "npm run start --prefix central-backend",
    "backend:dev": "npm run dev --prefix central-backend",
    "admin:dev": "npm run dev --prefix web-apps/admin-portal",
    "store:dev": "npm run dev --prefix web-apps/client-storefront",
    "pos:install": "bash scripts/pos-install.sh",
    "pos:rebuild": "npm run rebuild --prefix desktop-app",
    "pos:dev": "npm run dev --prefix desktop-app",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f",
    "prod:ps": "docker compose -f docker-compose.prod.yml --env-file .env.production ps"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
