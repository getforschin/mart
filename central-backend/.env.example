NODE_ENV=development
PORT=3000

# Option A — discrete fields (local docker-compose)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mart_admin
DATABASE_PASSWORD=mart_secure_pass_2026
DATABASE_NAME=mart_omnichannel

# Option B — cloud URL (Railway/Render/Neon/Supabase). If set, Option A is ignored.
# DATABASE_URL=postgres://user:pass@host:5432/mart_omnichannel

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://default:pass@host:6379

JWT_SECRET=change-this-to-a-secure-random-string-in-production
LOG_LEVEL=info

# Comma-separated origins, or * for any (dev)
CORS_ORIGINS=*

# Production bootstrap only — create schema without migrations
# TYPEORM_SYNCHRONIZE=true
