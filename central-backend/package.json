{
  "name": "central-backend",
  "version": "1.0.0",
  "description": "Multi-Tenant Omnichannel Retail Enterprise API Core",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsoa spec-and-routes && tsc",
    "start": "node dist/server.js",
    "dev": "npm run build && ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node --transpile-only scripts/seed.ts",
    "setup": "npm install && npm run build && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm -- migration:run -d src/core/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/core/database/data-source.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.4.0",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
